{
  "name": "desktop-fairy",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently --kill-others \"npm run dev:vite\" \"npm run dev:electron\"",
    "dev:vite": "vite",
    "dev:electron": "wait-on http://localhost:5173 && electron .",
    "build": "tsc -b && vite build && electron-builder",
    "build:dir": "tsc -b && vite build && electron-builder --dir",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "preview": "vite preview"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.99",
    "@ai-sdk/openai": "^3.0.82",
    "@ai-sdk/openai-compatible": "^2.0.37",
    "@ai-sdk/provider": "^3.0.13",
    "@ai-sdk/provider-utils": "^4.0.37",
    "@ai-sdk/react": "^3.0.223",
    "@cherrystudio/ai-core": "^2.0.1",
    "@cherrystudio/mac-system-ocr": "^0.2.7",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@tanstack/react-virtual": "^3.14.7",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "ai": "^6.0.143",
    "better-sqlite3": "^13.0.3",
    "jszip": "^3.10.1",
    "mammoth": "^1.12.2",
    "node-pty": "^1.1.0",
    "ollama-ai-provider-v2": "^3.3.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "streamdown": "^2.6.0",
    "@streamdown/code": "^1.1.1",
    "@streamdown/cjk": "^1.0.3",
    "@streamdown/math": "^1.0.2",
    "@streamdown/mermaid": "^1.0.2",
    "selection-hook": "^2.1.0",
    "smol-toml": "^1.7.0",
    "sqlite-vec": "^0.1.9",
    "ssh2": "^1.17.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/jszip": "^3.4.0",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/ui": "^4.1.9",
    "concurrently": "^9.1.2",
    "electron": "^35.4.0",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.28.0",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "remark-gfm": "^4.0.1",
    "remark-cjk-friendly": "^2.0.1",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12",
    "vitest": "^4.1.9",
    "wait-on": "^8.0.3"
  },
  "build": {
    "appId": "com.desktop.fairy",
    "productName": "DesktopFairy",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "!node_modules/selection-hook/prebuilds/**/*",
      "!node_modules/selection-hook/src/**/*",
      "!node_modules/node-pty/prebuilds/win32-arm64/**/*",
      "!node_modules/node-pty/prebuilds/win32-x64/**/*",
      "!node_modules/node-pty/prebuilds/darwin-x64/**/*"
    ],
    "asarUnpack": [
      "dist/models/**",
      "dist/shaders/**",
      "dist/live2dcubismcore.min.js",
      "**/*.node",
      "**/node-pty/**/spawn-helper"
    ],
    "extraResources": [
      {
        "from": "resources/agent-skills",
        "to": "agent-skills"
      }
    ],
    "npmRebuild": true,
    "buildDependenciesFromSource": false,
    "mac": {
      "category": "public.app-category.entertainment",
      "target": "dmg",
      "icon": "build/icon.png",
      "identity": null,
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extendInfo": {
        "LSUIElement": true,
        "NSAccessibilityUsageDescription": "DesktopFairy 需要辅助功能权限以读取您选中的文字，用于划词助手。"
      }
    }
  },
  "allowScripts": {
    "node-pty@1.1.0": true,
    "better-sqlite3": true
  }
}
